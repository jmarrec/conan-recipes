diff --git a/win32/setup.mak b/win32/setup.mak
index a1a0ce49..b8e61349 100644
--- a/win32/setup.mak
+++ b/win32/setup.mak
@@ -227,7 +227,9 @@ RUBY_SO_NAME = $(RUBY_SO_NAME)
 
 -generic-: nul
 	@$(CPP) <<conftest.c 2>nul | findstr = >>$(MAKEFILE)
-#if defined _M_X64
+#if defined _M_ARM64
+MACHINE = arm64
+#elif defined _M_X64
 MACHINE = x64
 #else
 MACHINE = x86
@@ -241,6 +243,8 @@ MACHINE = x86
 	@echo MACHINE = alpha>>$(MAKEFILE)
 -x64-: -osname64-
 	@echo MACHINE = x64>>$(MAKEFILE)
+-arm64-: -osname64-
